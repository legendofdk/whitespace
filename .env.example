# Frontend public API base URL.
# Local: http://localhost:4000
# Vercel: https://your-backend-domain.vercel.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Optional server-side backend URL override for Next.js server routes and SSR.
# If omitted, the app falls back to NEXT_PUBLIC_BACKEND_URL.
BACKEND_URL=http://localhost:4000

# Public Google Maps key used in client-side map components.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_google_maps_api_key

# Server-side Google Maps key used by app/api/nearby.
GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key

# Cloudinary credentials used by frontend server routes for admin uploads.
CLOUDINARY_CLOUD_NAME="djjaxwe4y"
CLOUDINARY_API_KEY="474259877894485"
CLOUDINARY_API_SECRET="Ur0pAXDqsft3mzBsCc62gTQnGOo"

# Admin credentials used by the Next.js admin session helper.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_AUTH_SECRET=replace-with-a-long-random-string
